# runtime
NODE_ENV=development
PORT=5000

# database
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<db>

# auth : supply strong, unique secrets in production
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BYCRYPT_SALT_ROUNDS=10
DEFAULT_PASS=ChangeMe@123

# interactive demo sandbox
DEMO_PASSWORD=Demo@123

# cors : comma separated allow-list, supports wildcards such as https://*.vercel.app
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# optional event / cache infrastructure (features degrade gracefully when unset)
KAFKA_BROKERS=
KAFKA_CLIENT_ID=clinical-erp
RABBITMQ_URL=
REDIS_URL=
AUDIT_LOG_TTL_DAYS=30
RAZORPAY_WEBHOOK_SECRET=
